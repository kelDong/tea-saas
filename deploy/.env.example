# ============================================================
# tea-saas 生产环境变量模板
# 用法：复制为 .env 后逐项填写（.env 已 gitignore，禁止入库）
# 注意：密码建议仅用字母数字，避免 $ 等特殊字符在不同解析层被转义
# ============================================================

# ---- 对外入口 ----
# nginx 监听的宿主端口（本机演练 8090，避开 dev 已占用的 80/5173/8080/3307/6379/9000）
NGINX_PORT=8090

# ---- 对外 URL 基地址（拼进后端返回的 OSS 图片 URL，浏览器要能直接打开） ----
# 本机演练：    http://localhost:8090/oss
# 云服务器：    http://<你的域名或公网IP>[:端口]/oss
# !! 不能填 localhost 上云 —— Linux 容器内 localhost 指向自身 !!
OSS_PUBLIC_ENDPOINT=http://localhost:8090/oss

# ---- 首启管理员密码（admin 账号，仅首次启动且 DB 仍是占位哈希时生效） ----
# 登录成功一次后即可从 .env 移除（纯字母数字，避免特殊字符转义坑）
TEA_ADMIN_PASSWORD=

# ---- MySQL ----
MYSQL_DB=tea_saas
MYSQL_USER=tea
# 以下两项必填，留空则 compose 直接报错拒绝启动
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# ---- Redis ----
REDIS_PASSWORD=

# ---- MinIO 对象存储 ----
# 即 MinIO root 账号（access key >=3 位，secret key >=8 位）
OSS_ACCESS_KEY=
OSS_SECRET_KEY=
OSS_BUCKET=tea-saas

# ---- JVM 参数 ----
JAVA_OPTS=-Xms512m -Xmx1024m

# ---- 微信支付 V3（资质下发后取消注释并填写；当前 tea.pay.mock=true 不需要） ----
# WX_PAY_APP_ID=
# WX_PAY_MCH_ID=
# WX_PAY_MCH_SERIAL_NO=
# WX_PAY_PRIVATE_KEY_PATH=
# WX_PAY_API_V3_KEY=
# WX_PAY_NOTIFY_URL_BASE=
