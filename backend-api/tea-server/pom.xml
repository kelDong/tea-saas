<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.teasaas</groupId>
        <artifactId>tea-saas-backend</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>tea-server</artifactId>
    <name>tea-server</name>
    <description>启动模块：聚合入口，只含启动类与配置（禁止业务代码）</description>

    <dependencies>
        <dependency><groupId>com.teasaas</groupId><artifactId>tea-common</artifactId></dependency>
        <dependency><groupId>com.teasaas</groupId><artifactId>tea-framework</artifactId></dependency>
        <dependency><groupId>com.teasaas</groupId><artifactId>tea-system</artifactId></dependency>
        <dependency><groupId>com.teasaas</groupId><artifactId>tea-franchise</artifactId></dependency>
        <dependency><groupId>com.teasaas</groupId><artifactId>tea-supply</artifactId></dependency>
        <dependency><groupId>com.teasaas</groupId><artifactId>tea-bom</artifactId></dependency>
        <dependency><groupId>com.teasaas</groupId><artifactId>tea-product</artifactId></dependency>
        <dependency><groupId>com.teasaas</groupId><artifactId>tea-inventory</artifactId></dependency>
        <dependency><groupId>com.teasaas</groupId><artifactId>tea-order</artifactId></dependency>
        <dependency><groupId>com.teasaas</groupId><artifactId>tea-payment</artifactId></dependency>
        <dependency><groupId>com.teasaas</groupId><artifactId>tea-member</artifactId></dependency>
        <dependency><groupId>com.teasaas</groupId><artifactId>tea-marketing</artifactId></dependency>
        <dependency><groupId>com.teasaas</groupId><artifactId>tea-report</artifactId></dependency>
        <dependency><groupId>com.teasaas</groupId><artifactId>tea-job</artifactId></dependency>

        <!-- MySQL 驱动 -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- 接口文档 -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
