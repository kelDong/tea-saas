<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.5</version>
        <relativePath/>
    </parent>

    <groupId>com.teasaas</groupId>
    <artifactId>tea-saas-backend</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>tea-saas-backend</name>
    <description>茶饮连锁加盟 SaaS 管理系统 - 后端（模块化单体 · 多租户）</description>

    <modules>
        <module>tea-common</module>
        <module>tea-framework</module>
        <module>tea-system</module>
        <module>tea-franchise</module>
        <module>tea-supply</module>
        <module>tea-bom</module>
        <module>tea-product</module>
        <module>tea-inventory</module>
        <module>tea-order</module>
        <module>tea-payment</module>
        <module>tea-member</module>
        <module>tea-marketing</module>
        <module>tea-report</module>
        <module>tea-job</module>
        <module>tea-server</module>
        <module>tea-generator</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- 依赖版本（与工程规范 v1.1 一致） -->
        <mybatis-plus.version>3.5.12</mybatis-plus.version>
        <sa-token.version>1.44.0</sa-token.version>
        <hutool.version>5.8.38</hutool.version>
        <mapstruct.version>1.6.3</mapstruct.version>
        <springdoc.version>2.8.6</springdoc.version>
        <minio.version>8.5.17</minio.version>
        <wechatpay-java.version>0.2.17</wechatpay-java.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- 内部模块 -->
            <dependency><groupId>com.teasaas</groupId><artifactId>tea-common</artifactId><version>${project.version}</version></dependency>
            <dependency><groupId>com.teasaas</groupId><artifactId>tea-framework</artifactId><version>${project.version}</version></dependency>
            <dependency><groupId>com.teasaas</groupId><artifactId>tea-system</artifactId><version>${project.version}</version></dependency>
            <dependency><groupId>com.teasaas</groupId><artifactId>tea-franchise</artifactId><version>${project.version}</version></dependency>
            <dependency><groupId>com.teasaas</groupId><artifactId>tea-supply</artifactId><version>${project.version}</version></dependency>
            <dependency><groupId>com.teasaas</groupId><artifactId>tea-bom</artifactId><version>${project.version}</version></dependency>
            <dependency><groupId>com.teasaas</groupId><artifactId>tea-product</artifactId><version>${project.version}</version></dependency>
            <dependency><groupId>com.teasaas</groupId><artifactId>tea-inventory</artifactId><version>${project.version}</version></dependency>
            <dependency><groupId>com.teasaas</groupId><artifactId>tea-order</artifactId><version>${project.version}</version></dependency>
            <dependency><groupId>com.teasaas</groupId><artifactId>tea-payment</artifactId><version>${project.version}</version></dependency>
            <dependency><groupId>com.teasaas</groupId><artifactId>tea-member</artifactId><version>${project.version}</version></dependency>
            <dependency><groupId>com.teasaas</groupId><artifactId>tea-marketing</artifactId><version>${project.version}</version></dependency>
            <dependency><groupId>com.teasaas</groupId><artifactId>tea-report</artifactId><version>${project.version}</version></dependency>
            <dependency><groupId>com.teasaas</groupId><artifactId>tea-job</artifactId><version>${project.version}</version></dependency>

            <!-- MyBatis-Plus（Spring Boot 3 专用） -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
            <!-- MP 3.5.9+ 拆分的 jsqlparser 支持（租户/分页插件依赖） -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-jsqlparser</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>

            <!-- Sa-Token -->
            <dependency>
                <groupId>cn.dev33</groupId>
                <artifactId>sa-token-spring-boot3-starter</artifactId>
                <version>${sa-token.version}</version>
            </dependency>
            <dependency>
                <groupId>cn.dev33</groupId>
                <artifactId>sa-token-redis-jackson</artifactId>
                <version>${sa-token.version}</version>
            </dependency>

            <!-- Hutool 工具集 -->
            <dependency>
                <groupId>cn.hutool</groupId>
                <artifactId>hutool-all</artifactId>
                <version>${hutool.version}</version>
            </dependency>

            <!-- MapStruct -->
            <dependency>
                <groupId>org.mapstruct</groupId>
                <artifactId>mapstruct</artifactId>
                <version>${mapstruct.version}</version>
            </dependency>
            <dependency>
                <groupId>org.mapstruct</groupId>
                <artifactId>mapstruct-processor</artifactId>
                <version>${mapstruct.version}</version>
            </dependency>

            <!-- 接口文档 -->
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>

            <!-- MinIO 对象存储（商品图片等） -->
            <dependency>
                <groupId>io.minio</groupId>
                <artifactId>minio</artifactId>
                <version>${minio.version}</version>
            </dependency>

            <!-- 微信支付 V3 官方 SDK（统一下单/退款/回调验签解密） -->
            <dependency>
                <groupId>com.github.wechatpay-apiv3</groupId>
                <artifactId>wechatpay-java</artifactId>
                <version>${wechatpay-java.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <!-- 编译：JDK 21 + Lombok + MapStruct 注解处理器 -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <source>21</source>
                        <target>21</target>
                        <encoding>UTF-8</encoding>
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                                <version>${lombok.version}</version>
                            </path>
                            <path>
                                <groupId>org.mapstruct</groupId>
                                <artifactId>mapstruct-processor</artifactId>
                                <version>${mapstruct.version}</version>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>

                <!-- 规范校验：JDK 版本 + 依赖收敛 + 禁重复依赖（工程规范 2.3/13 章） -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-enforcer-plugin</artifactId>
                    <version>3.5.0</version>
                    <executions>
                        <execution>
                            <id>enforce-rules</id>
                            <goals><goal>enforce</goal></goals>
                            <configuration>
                                <rules>
                                    <requireJavaVersion><version>[21,22)</version></requireJavaVersion>
                                    <banDuplicatePomDependencyVersions/>
                                </rules>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>

                <!-- Spring Boot 打包（仅 tea-server 需要） -->
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <configuration>
                        <mainClass>com.teasaas.server.TeaSaasApplication</mainClass>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
